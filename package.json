{
    "name": "fluent-reader-alpine",
    "version": "0.1.0",
    "description": "A lightweight Tauri-based fork of Fluent Reader",
    "keywords": [
        "fluent",
        "reader",
        "rss",
        "tauri"
    ],
    "license": "BSD-3-Clause",
    "author": "Haoyuan Liu",
    "repository": "github:ljh12138164/fluent-reader-alpine",
    "sideEffects": [
        "*.css",
        "./src/preload.ts"
    ],
    "scripts": {
        "build": "rspack build -c ./rspack.config.js",
        "tauri": "tauri",
        "start": "tauri dev",
        "dev": "tauri dev",
        "check": "oxlint src rspack.config.js && oxfmt --check && tsc --noEmit",
        "format": "oxfmt",
        "package": "tauri build",
        "package-win": "tauri build",
        "package-win-ci": "tauri build",
        "package-mac": "tauri build",
        "package-linux": "tauri build"
    },
    "devDependencies": {
        "@fluentui/react": "^8.125.9",
        "@fluentui/react-components": "^9.73.7",
        "@fluentui/react-icons": "2.0.323",
        "@fluentui/react-migration-v8-v9": "^9.10.9",
        "@fluentui/react-shared-contexts": "^9.26.2",
        "@fluentui/react-tabster": "9.26.13",
        "@griffel/react": "^1.6.1",
        "@rspack/cli": "^2.3.2",
        "@rspack/core": "^2.3.2",
        "@tauri-apps/cli": "^2.5.0",
        "@tauri-apps/plugin-http": "^2.9.0",
        "@tauri-apps/plugin-notification": "2.8.1",
        "@types/lovefield": "^2.1.3",
        "@types/node": "25.5.0",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "css-loader": "^7.1.4",
        "drizzle-orm": "^0.45.2",
        "js-md5": "^0.7.3",
        "lovefield": "^2.1.12",
        "node-polyfill-webpack-plugin": "^4.0.0",
        "oxfmt": "^0.78.0",
        "oxlint": "^1.93.0",
        "qrcode.react": "^4.2.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-intl-universal": "^2.2.5",
        "react-redux": "^9.3.1",
        "redux": "^5.0.1",
        "redux-thunk": "^3.1.0",
        "reselect": "^4.0.0",
        "rss-parser": "^3.13.0",
        "typescript": "^6.0.2",
        "webpack": "^5.105.4"
    },
    "packageManager": "pnpm@12.18.0"
}
